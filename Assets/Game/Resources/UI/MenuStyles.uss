.screen-root {
    flex-grow: 1;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(76, 111, 126);
    -unity-font: url("/Assets/Game/Resources/UI/Fonts/Silkscreen-Regular.ttf");
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 8, 13, 0.95);
}

.placeholder-backdrop {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0);
}

.video-background {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.left-shade {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 42%;
    background-color: rgba(0, 0, 0, 0.15);
}

.crt-noise {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0);
}

.scan-line {
    position: absolute;
    left: 0;
    right: 0;
    height: 1px;
    background-color: rgba(0, 0, 0, 0.09);
}

.gameplay-placeholder .placeholder-backdrop {
    background-color: rgba(0, 0, 0, 0);
}

.gameplay-placeholder .left-shade {
    background-color: rgba(0, 0, 0, 0);
}

.gameplay-background {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.office-fight-image,
.office-spray-bottle-foreground,
.office-fight-blackout {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.office-fight-blackout {
    background-color: rgb(0, 0, 0);
    opacity: 0;
}

.office-state-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.office-state-clip {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.office-state-image {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.menu-content {
    position: absolute;
    left: 7%;
    top: 13%;
    bottom: 10%;
    width: 620px;
    justify-content: center;
}

.title-block {
    margin-bottom: 44px;
}

.game-title,
.game-title-accent {
    height: 76px;
    color: rgb(79, 119, 136);
    font-size: 72px;
    letter-spacing: 1px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(1, 11, 17);
}

.game-title-accent {
    margin-top: -8px;
    color: rgb(58, 105, 125);
}

.game-subtitle {
    margin-top: 16px;
    color: rgb(48, 78, 92);
    font-size: 18px;
    letter-spacing: 1px;
}

.current-night-label {
    margin-top: 18px;
    color: rgb(90, 139, 157);
    font-size: 18px;
    letter-spacing: 3px;
}

.menu-actions {
    width: 370px;
}

.menu-button {
    width: 360px;
    height: 54px;
    margin-bottom: 8px;
    padding-left: 16px;
    padding-right: 8px;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 2px;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    border-left-color: rgba(48, 90, 108, 0);
    border-radius: 0;
    color: rgb(66, 104, 121);
    font-size: 24px;
    letter-spacing: 2px;
    -unity-text-align: middle-left;
    transition-property: color, border-left-color, translate;
    transition-duration: 0.08s;
}

.menu-button:hover,
.menu-button:focus {
    translate: 5px 0;
    background-color: rgba(0, 0, 0, 0);
    border-left-color: rgb(75, 132, 155);
    color: rgb(93, 148, 170);
}

.menu-button:active {
    color: rgb(122, 172, 190);
}

.primary-button {
    color: rgb(77, 124, 142);
}

.footer-label {
    position: absolute;
    left: 7%;
    bottom: 28px;
    color: rgb(38, 64, 75);
    font-size: 13px;
    letter-spacing: 1px;
}

.eyebrow {
    color: rgb(68, 111, 129);
    font-size: 13px;
    letter-spacing: 1px;
}

.settings-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 5, 9, 0.9);
}

.settings-panel {
    width: 580px;
    max-height: 90%;
    padding: 46px;
    background-color: rgb(4, 13, 19);
    border-left-width: 2px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(53, 99, 119);
    border-right-color: rgb(24, 47, 58);
    border-top-color: rgb(24, 47, 58);
    border-bottom-color: rgb(24, 47, 58);
}

.panel-title {
    margin-bottom: 12px;
    color: rgb(82, 126, 144);
    font-size: 34px;
    letter-spacing: 2px;
}

.panel-description {
    margin-bottom: 44px;
    color: rgb(48, 77, 89);
    font-size: 12px;
}

.settings-control {
    min-height: 54px;
    margin-bottom: 22px;
    color: rgb(68, 107, 123);
    font-size: 14px;
    letter-spacing: 1px;
}

.settings-back-button {
    margin-top: 20px;
}

.settings-section-label {
    margin-top: 8px;
    margin-bottom: 8px;
    color: rgb(78, 120, 137);
    font-size: 16px;
    letter-spacing: 2px;
}

.night-progress-description {
    margin-bottom: 12px;
    color: rgb(54, 87, 100);
    font-size: 13px;
    letter-spacing: 1px;
}

.reset-progress-button {
    height: 46px;
    margin-bottom: 4px;
    color: rgb(145, 82, 77);
    font-size: 16px;
}

.progress-reset-status {
    height: 26px;
    margin-bottom: 4px;
    color: rgb(113, 151, 122);
    font-size: 12px;
    letter-spacing: 1px;
}

.night-intro-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgb(0, 0, 0);
}

.night-intro-title {
    color: rgb(218, 223, 225);
    font-size: 52px;
    letter-spacing: 4px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(40, 44, 46);
}

.demo-hud {
    position: absolute;
    left: 54px;
    right: 54px;
    top: 40px;
    height: 70px;
    flex-direction: row;
    justify-content: flex-end;
    align-items: flex-start;
}

.clock-label {
    padding: 8px 12px;
    background-color: rgba(0, 0, 0, 0.36);
    color: rgb(103, 141, 156);
    font-size: 34px;
    letter-spacing: 2px;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.95);
}

.mute-phone-call-button {
    position: absolute;
    left: 40px;
    top: 38px;
    width: 156px;
    height: 44px;
    padding: 0;
    background-color: rgba(2, 7, 9, 0.88);
    border-left-width: 2px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(127, 53, 49);
    border-right-color: rgb(53, 39, 39);
    border-top-color: rgb(77, 49, 48);
    border-bottom-color: rgb(38, 29, 29);
    border-radius: 0;
    color: rgb(171, 104, 98);
    font-size: 15px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.95);
}

.mute-phone-call-button:hover,
.mute-phone-call-button:focus {
    background-color: rgba(21, 9, 9, 0.94);
    border-left-color: rgb(191, 75, 67);
    color: rgb(218, 137, 128);
}

.mute-phone-call-button:active {
    translate: 0 2px;
}

.battery-hud {
    position: absolute;
    left: 54px;
    bottom: 42px;
    padding: 10px 14px;
    background-color: rgba(0, 0, 0, 0.38);
}

.battery-caption {
    color: rgb(72, 100, 111);
    font-size: 13px;
    letter-spacing: 1px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.95);
}

.battery-value {
    margin-top: 3px;
    color: rgb(103, 141, 156);
    font-size: 28px;
    letter-spacing: 2px;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.95);
}

.battery-safe {
    color: rgb(75, 166, 91);
}

.battery-warning {
    color: rgb(202, 166, 54);
}

.battery-critical {
    color: rgb(199, 57, 57);
}

.office-controls-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.office-spray-button {
    position: absolute;
    left: 50%;
    bottom: 18px;
    width: 150px;
    height: 52px;
    translate: 222px 0;
    padding: 0;
    background-color: rgba(3, 9, 11, 0.9);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 2px;
    border-bottom-width: 1px;
    border-left-color: rgb(38, 61, 69);
    border-right-color: rgb(38, 61, 69);
    border-top-color: rgb(76, 112, 126);
    border-bottom-color: rgb(21, 36, 42);
    border-radius: 0;
    color: rgb(78, 113, 126);
    font-size: 17px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
}

.office-spray-button:hover,
.office-spray-button:focus {
    background-color: rgba(9, 21, 25, 0.96);
    color: rgb(111, 151, 165);
    border-top-color: rgb(104, 148, 164);
}

.office-spray-button:active {
    translate: 222px 2px;
}

.office-spray-button-threat {
    border-left-color: rgb(213, 178, 51);
    border-right-color: rgb(116, 98, 36);
    border-top-color: rgb(213, 178, 51);
    color: rgb(229, 209, 114);
}

.office-controls {
    position: absolute;
    top: 31%;
    width: 112px;
    padding: 8px;
    background-color: rgba(2, 5, 6, 0.76);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgb(35, 45, 47);
    border-bottom-color: rgb(18, 24, 26);
}

.office-controls-left {
    left: 0;
    border-right-width: 2px;
    border-right-color: rgb(42, 54, 57);
}

.office-controls-right {
    right: 0;
    border-left-width: 2px;
    border-left-color: rgb(42, 54, 57);
}

.office-control-button {
    width: 96px;
    height: 62px;
    margin-top: 4px;
    margin-bottom: 4px;
    padding: 0;
    background-color: rgb(11, 15, 16);
    border-left-width: 4px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-right-color: rgb(43, 51, 52);
    border-top-color: rgb(43, 51, 52);
    border-bottom-color: rgb(24, 29, 30);
    border-radius: 0;
    color: rgb(102, 118, 122);
    font-size: 16px;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
}

.door-control-button {
    border-left-color: rgb(111, 43, 45);
}

.light-control-button {
    border-left-color: rgb(123, 105, 42);
}

.office-control-button:hover,
.office-control-button:focus {
    background-color: rgb(20, 27, 29);
    color: rgb(137, 155, 160);
}

.office-control-button:active {
    translate: 1px 1px;
    background-color: rgb(6, 9, 10);
}

.office-control-button:disabled,
.camera-toggle-button:disabled {
    opacity: 0.28;
    color: rgb(51, 57, 59);
    border-left-color: rgb(37, 40, 41);
    border-right-color: rgb(27, 30, 31);
    border-top-color: rgb(27, 30, 31);
    border-bottom-color: rgb(18, 20, 21);
}

.door-control-button.office-control-active {
    background-color: rgb(62, 19, 21);
    border-left-color: rgb(203, 62, 65);
    border-right-color: rgb(112, 38, 40);
    border-top-color: rgb(112, 38, 40);
    border-bottom-color: rgb(76, 25, 27);
    color: rgb(231, 137, 139);
}

.light-control-button.office-control-active {
    background-color: rgb(70, 58, 13);
    border-left-color: rgb(229, 195, 58);
    border-right-color: rgb(134, 111, 34);
    border-top-color: rgb(134, 111, 34);
    border-bottom-color: rgb(88, 73, 22);
    color: rgb(242, 218, 126);
}

.camera-toggle-button {
    position: absolute;
    left: 50%;
    bottom: 18px;
    width: 420px;
    height: 52px;
    translate: -210px 0;
    padding: 0;
    background-color: rgba(3, 9, 11, 0.9);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 2px;
    border-bottom-width: 1px;
    border-left-color: rgb(38, 61, 69);
    border-right-color: rgb(38, 61, 69);
    border-top-color: rgb(76, 112, 126);
    border-bottom-color: rgb(21, 36, 42);
    border-radius: 0;
    color: rgb(78, 113, 126);
    font-size: 17px;
    letter-spacing: 2px;
}

.camera-toggle-button:hover,
.camera-toggle-button:focus {
    background-color: rgba(9, 21, 25, 0.96);
    color: rgb(111, 151, 165);
    border-top-color: rgb(104, 148, 164);
}

.camera-toggle-button:active {
    translate: -210px 2px;
}

.power-failure-dim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
    opacity: 0.82;
}

.camera-dashboard {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding: 42px 52px 86px 52px;
    background-color: rgba(1, 5, 7, 0.97);
}

.camera-top-bar {
    height: 66px;
    padding-right: 170px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-bottom-width: 1px;
    border-bottom-color: rgb(36, 63, 73);
}

.camera-dashboard-title {
    color: rgb(89, 128, 142);
    font-size: 28px;
    letter-spacing: 3px;
}

.active-camera-label {
    color: rgb(110, 151, 165);
    font-size: 25px;
    letter-spacing: 2px;
}

.camera-workspace {
    flex-grow: 1;
    margin-top: 26px;
    flex-direction: row;
}

.camera-feed-panel,
.camera-map-panel {
    background-color: rgba(3, 11, 14, 0.88);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(29, 52, 60);
    border-right-color: rgb(17, 34, 40);
    border-top-color: rgb(29, 52, 60);
    border-bottom-color: rgb(17, 34, 40);
}

.camera-feed-panel {
    flex-grow: 1;
    margin-right: 26px;
    padding: 20px;
}

.camera-map-panel {
    width: 620px;
    padding: 20px;
}

.camera-section-label {
    height: 30px;
    color: rgb(60, 93, 105);
    font-size: 14px;
    letter-spacing: 2px;
}

.camera-feed-viewport {
    position: relative;
    flex-grow: 1;
    align-self: stretch;
    overflow: hidden;
    background-color: rgb(1, 4, 5);
}

.camera-feed-image {
    position: absolute;
    left: -2.5%;
    top: -2.5%;
    width: 105%;
    height: 105%;
    opacity: 0.96;
}

.bolojan-camera-image {
    position: absolute;
    left: 0;
    top: 0;
    opacity: 0.9;
}

.camera-feed-placeholder {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding-top: 28%;
    background-color: rgb(1, 4, 5);
    color: rgb(55, 79, 87);
    font-size: 24px;
    letter-spacing: 2px;
    -unity-text-align: upper-center;
    white-space: normal;
}

.camera-feed-flicker {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgb(174, 200, 204);
    opacity: 0.015;
}

.camera-feed-scan-bar {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 2px;
    background-color: rgba(174, 205, 210, 0.32);
    opacity: 0.18;
}

.camera-feed-loading-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgb(1, 4, 5);
}

.camera-feed-loading-label {
    color: rgb(74, 105, 115);
    font-size: 19px;
    letter-spacing: 4px;
    -unity-text-align: middle-center;
}

.dorian-blender-panel {
    position: absolute;
    right: 18px;
    bottom: 18px;
    width: 300px;
    padding: 14px;
    background-color: rgba(2, 8, 10, 0.92);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(62, 105, 116);
    border-right-color: rgb(35, 64, 72);
    border-top-color: rgb(35, 64, 72);
    border-bottom-color: rgb(35, 64, 72);
}

.dorian-blender-title {
    height: 20px;
    color: rgb(135, 169, 178);
    font-size: 12px;
    letter-spacing: 2px;
}

.dorian-blender-meter {
    height: 18px;
    margin-top: 5px;
    margin-bottom: 7px;
    overflow: hidden;
    background-color: rgb(5, 16, 19);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(32, 58, 64);
    border-right-color: rgb(32, 58, 64);
    border-top-color: rgb(32, 58, 64);
    border-bottom-color: rgb(32, 58, 64);
}

.dorian-blender-fill {
    height: 100%;
    background-color: rgb(72, 151, 128);
}

.dorian-blender-status {
    height: 20px;
    color: rgb(91, 133, 143);
    font-size: 10px;
    letter-spacing: 1px;
}

.dorian-charge-button {
    height: 38px;
    margin-top: 4px;
    padding: 0;
    background-color: rgb(13, 35, 41);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(77, 120, 131);
    border-right-color: rgb(77, 120, 131);
    border-top-color: rgb(77, 120, 131);
    border-bottom-color: rgb(77, 120, 131);
    border-radius: 0;
    color: rgb(169, 194, 200);
    font-size: 12px;
    letter-spacing: 2px;
}

.dorian-charge-button:hover,
.dorian-charge-button:focus {
    background-color: rgb(23, 55, 62);
    color: rgb(213, 225, 228);
}

.dorian-blender-warning .dorian-blender-fill {
    background-color: rgb(190, 130, 38);
}

.dorian-blender-warning .dorian-blender-status {
    color: rgb(225, 168, 64);
}

.dorian-blender-danger {
    border-left-color: rgb(146, 44, 37);
    border-right-color: rgb(102, 31, 28);
    border-top-color: rgb(102, 31, 28);
    border-bottom-color: rgb(102, 31, 28);
}

.dorian-blender-danger .dorian-blender-fill {
    background-color: rgb(177, 45, 38);
}

.dorian-blender-danger .dorian-blender-status {
    color: rgb(226, 76, 65);
}

.camera-map {
    position: relative;
    flex-grow: 1;
    margin-top: 8px;
    background-color: rgb(2, 7, 9);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(23, 44, 51);
    border-right-color: rgb(23, 44, 51);
    border-top-color: rgb(23, 44, 51);
    border-bottom-color: rgb(23, 44, 51);
}

.camera-map-room {
    position: absolute;
    align-items: center;
    justify-content: flex-start;
    padding-top: 6px;
    background-color: rgba(8, 19, 23, 0.76);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(38, 64, 73);
    border-right-color: rgb(38, 64, 73);
    border-top-color: rgb(38, 64, 73);
    border-bottom-color: rgb(38, 64, 73);
}

.camera-map-room-label {
    color: rgb(42, 67, 76);
    font-size: 10px;
    letter-spacing: 1px;
    white-space: normal;
    -unity-text-align: upper-center;
}

.camera-route-segment {
    position: absolute;
    background-color: rgb(91, 139, 153);
    opacity: 0.9;
}

.camera-node-button {
    position: absolute;
    width: 70px;
    height: 32px;
    padding: 0;
    background-color: rgb(10, 25, 30);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(49, 83, 94);
    border-right-color: rgb(49, 83, 94);
    border-top-color: rgb(49, 83, 94);
    border-bottom-color: rgb(49, 83, 94);
    border-radius: 0;
    color: rgb(79, 116, 129);
    font-size: 10px;
    letter-spacing: 1px;
}

.camera-player-marker {
    position: absolute;
    width: 58px;
    height: 27px;
    padding-top: 5px;
    background-color: rgb(72, 54, 18);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(185, 145, 53);
    border-right-color: rgb(185, 145, 53);
    border-top-color: rgb(185, 145, 53);
    border-bottom-color: rgb(185, 145, 53);
    color: rgb(226, 191, 105);
    font-size: 10px;
    letter-spacing: 1px;
    -unity-text-align: upper-center;
}

.camera-node-button:hover,
.camera-node-button:focus {
    background-color: rgb(16, 38, 45);
    color: rgb(117, 157, 171);
}

.camera-node-selected {
    background-color: rgb(35, 70, 79);
    border-left-color: rgb(111, 157, 171);
    border-right-color: rgb(111, 157, 171);
    border-top-color: rgb(111, 157, 171);
    border-bottom-color: rgb(111, 157, 171);
    color: rgb(151, 187, 198);
}

.bolojan-jumpscare-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: rgb(0, 0, 0);
}

.bolojan-jumpscare-image {
    position: absolute;
    left: -3%;
    top: -3%;
    width: 106%;
    height: 106%;
}

.bolojan-tax-flash {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 9%;
    height: 118px;
    padding-top: 18px;
    background-color: rgba(0, 18, 110, 0.02);
    color: rgb(255, 255, 255);
    font-size: 68px;
    letter-spacing: 7px;
    -unity-text-align: upper-center;
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: rgb(24, 0, 0);
}

.night-result-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 2, 4, 0.97);
}

.night-result-panel {
    width: 720px;
    min-height: 390px;
    padding: 54px 60px;
    align-items: center;
    justify-content: center;
    background-color: rgb(3, 10, 14);
    border-left-width: 2px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(73, 111, 125);
    border-right-color: rgb(25, 43, 50);
    border-top-color: rgb(25, 43, 50);
    border-bottom-color: rgb(25, 43, 50);
}

.night-result-title {
    margin-bottom: 26px;
    color: rgb(213, 220, 222);
    font-size: 54px;
    letter-spacing: 5px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(20, 25, 27);
}

.night-result-loss-title {
    color: rgb(199, 58, 56);
    font-size: 42px;
    letter-spacing: 3px;
    -unity-text-outline-color: rgb(35, 3, 3);
}

.night-result-message {
    min-height: 72px;
    margin-bottom: 34px;
    color: rgb(92, 128, 141);
    font-size: 18px;
    letter-spacing: 1px;
    white-space: normal;
    -unity-text-align: middle-center;
}

.night-result-actions {
    width: 370px;
    align-items: center;
}

.power-readout {
    align-items: flex-end;
}

.power-caption {
    color: rgb(46, 77, 90);
    font-size: 11px;
    letter-spacing: 1px;
}

.power-value {
    color: rgb(75, 128, 149);
    font-size: 25px;
}

.placeholder-card {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 600px;
    min-height: 350px;
    translate: -300px -175px;
    padding: 44px;
    background-color: rgba(4, 14, 20, 0.96);
    border-left-width: 2px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(56, 105, 124);
    border-right-color: rgb(23, 47, 57);
    border-top-color: rgb(23, 47, 57);
    border-bottom-color: rgb(23, 47, 57);
}

.placeholder-heading {
    margin-top: 12px;
    color: rgb(81, 126, 144);
    font-size: 29px;
    letter-spacing: 2px;
}

.placeholder-copy {
    margin-top: 24px;
    margin-bottom: 34px;
    color: rgb(55, 87, 100);
    font-size: 13px;
    white-space: normal;
}
